{
  "name": "my-video",
  "version": "1.0.0",
  "description": "Remotion video project with 3D, audio, and voice narration",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render MyComp out/out.mp4",
    "still": "remotion still MyComp out/out.png --frame=30",
    "upgrade": "remotion upgrade",
    "lint": "eslint src --ext .ts,.tsx",
    "generate:voice": "tsx scripts/generate-voice.ts",
    "generate:assets": "npm run generate:voice",
    "render:all": "npm run build && npm run build -- --composition=ThreeDDemo --output=out/3d.mp4 && npm run build -- --composition=MyComp --output=out/square.mp4 --width=1080 --height=1080"
  },
  "dependencies": {
    "remotion": "4.0.545",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@remotion/three": "4.0.545",
    "@remotion/media-utils": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "@remotion/elevenlabs": "4.0.545",
    "@remotion/player": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@remotion/lambda": "4.0.545",
    "three": "^0.169.0",
    "@types/three": "^0.169.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/tailwind-v4": "4.0.545",
    "typescript": "^5.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0"
  }
}